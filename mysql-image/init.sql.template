-- =========================================================
-- PaaS Agent Assistant MySQL Initialization
-- =========================================================

CREATE DATABASE IF NOT EXISTS `${DB_NAME}`
    DEFAULT CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

CREATE USER IF NOT EXISTS '${DB_USERNAME}'@'%'
    IDENTIFIED BY '${DB_PASSWORD}';

GRANT ALL PRIVILEGES ON `${DB_NAME}`.* TO '${DB_USERNAME}'@'%';
FLUSH PRIVILEGES;

USE `${DB_NAME}`;

-- Remove legacy demo tables when the database is reused.
DROP TABLE IF EXISTS `feedback`;
DROP TABLE IF EXISTS `orders`;
DROP TABLE IF EXISTS `products`;
DROP TABLE IF EXISTS `users`;

CREATE TABLE IF NOT EXISTS `operation_approval` (
    `approval_id` VARCHAR(64) NOT NULL,
    `chat_id` VARCHAR(128) NOT NULL,
    `user_id` VARCHAR(128) NOT NULL,
    `action_type` VARCHAR(64) NOT NULL,
    `target_kind` VARCHAR(64) NOT NULL,
    `target_namespace` VARCHAR(255) DEFAULT NULL,
    `target_name` VARCHAR(255) NOT NULL,
    `plan_payload` LONGTEXT NOT NULL,
    `risk_level` VARCHAR(32) NOT NULL,
    `status` VARCHAR(32) NOT NULL,
    `expires_at` DATETIME NOT NULL,
    `approved_at` DATETIME DEFAULT NULL,
    `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (`approval_id`),
    KEY `idx_operation_approval_chat_id` (`chat_id`),
    KEY `idx_operation_approval_status` (`status`),
    KEY `idx_operation_approval_target` (`target_kind`, `target_namespace`, `target_name`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS `operation_execution` (
    `execution_id` VARCHAR(64) NOT NULL,
    `approval_id` VARCHAR(64) NOT NULL,
    `executor_user_id` VARCHAR(128) NOT NULL,
    `request_payload` LONGTEXT NOT NULL,
    `result_summary` LONGTEXT DEFAULT NULL,
    `success` TINYINT(1) DEFAULT NULL,
    `started_at` DATETIME NOT NULL,
    `finished_at` DATETIME DEFAULT NULL,
    `error_message` LONGTEXT DEFAULT NULL,
    `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (`execution_id`),
    KEY `idx_operation_execution_approval_id` (`approval_id`),
    CONSTRAINT `fk_operation_execution_approval`
        FOREIGN KEY (`approval_id`) REFERENCES `operation_approval` (`approval_id`)
        ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Session persistence tables are managed by the application runtime.
