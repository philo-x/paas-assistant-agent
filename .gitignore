offline-deps/*
!offline-deps/.gitkeep
!offline-deps/maven-repository/
offline-deps/maven-repository/**
!offline-deps/maven-repository/.gitkeep
!offline-deps/npm-cache/
offline-deps/npm-cache/**
!offline-deps/npm-cache/.gitkeep
offline-deps/node_modules-*.tar.gz
/.codex/config.toml

**/.DS_Store
